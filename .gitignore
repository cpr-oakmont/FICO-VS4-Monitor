# Credentials — never commit. Loaded by src/download.py via python-dotenv.
.env

# Raw GSE disclosure files (large, redistributable only under GSE terms)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

# Processed parquet (regenerable from raw)
data/processed/*.parquet

# Generated deliverables (regenerated by src/exhibits.py; history/adoption_log.csv
# is the committed record)
output/*.xlsx
output/exhibits/*.png

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
